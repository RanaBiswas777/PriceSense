# PriceSense environment configuration example.
# Copy this file to ".env" and fill in real values locally.
# Never commit the actual ".env" file or real secrets.

# --- Application metadata ---
APP_NAME=PriceSense
APP_TAGLINE=AI Product Price History & Smart Purchase Assistant

# --- Filesystem / data ---
DATABASE_FILENAME=pricesense.db
SAMPLE_PRICES_FILENAME=sample_prices.csv

# --- Local AI explanation (Phase 6; Ollama runs separately) ---
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b
OLLAMA_TIMEOUT_SECONDS=60

# --- Price analytics configuration (Phase 4) ---
# A price is LOW/HIGH when it differs from the historical average by at
# least this many percentage points; otherwise it is AVERAGE.
PRICE_STATUS_LOW_THRESHOLD_PERCENT=-10
PRICE_STATUS_HIGH_THRESHOLD_PERCENT=10
# Minimum observations required before a LOW/AVERAGE/HIGH status is computed.
MIN_OBSERVATIONS_FOR_STATUS=3
# Number of most-recent observations used for the "recent average" statistic.
RECENT_AVERAGE_WINDOW_SIZE=3
# Number of most-recent observations compared to compute the price trend.
TREND_WINDOW_SIZE=3
# Minimum % change over the trend window to be reported as upward/downward.
TREND_STABLE_THRESHOLD_PERCENT=2
